# =============================================================================
# Environment Configuration Example — safe to commit
# =============================================================================

# -- Database -----------------------------------------------------------------
DB_HOST=localhost
DB_NAME=vpn_wa_manager
DB_USER=your_db_user
DB_PASS=your_db_password

# -- GoWA Server ---------------------------------------------------------------
GOWA_BASE_URL=https://your-gowa-domain.tld
GOWA_USERNAME=your_gowa_username
GOWA_PASSWORD=your_gowa_password
GOWA_ADMIN_SEND_DEVICE_ID=

# -- App ----------------------------------------------------------------------
# Public URL without trailing slash
APP_URL=http://localhost/templatemo
# Timezone PHP (fallback jika php.ini server tidak di-set)
# Pilihan: Asia/Jakarta (WIB) | Asia/Makassar (WITA) | Asia/Jayapura (WIT)
APP_TIMEZONE=Asia/Jakarta

# -- Security -----------------------------------------------------------------
SECRET_BYTES=16

# -- Cron ---------------------------------------------------------------------
# Token for cron-reconnect.php HTTP access (use a strong random value)
CRON_SECRET=replace_with_a_long_random_secret

# -- WA Send Runtime -----------------------------------------------------------
WA_SEND_DELAY_MIN_MS=1000
WA_SEND_DELAY_MAX_MS=5000
WA_SEND_BURST_LIMIT=5
WA_SEND_BURST_WINDOW_SECONDS=60
WA_SEND_BURST_PAUSE_MIN_MS=25000
WA_SEND_BURST_PAUSE_MAX_MS=45000
WA_ADMIN_QUEUE_ENABLED=1
WA_USER_QUEUE_ENABLED=0
WA_QUEUE_BATCH_LIMIT=20
WA_QUEUE_MAX_ATTEMPTS=5
